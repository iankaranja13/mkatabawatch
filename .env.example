# MkatabaWatch Environment Configuration
# Copy this file to .env and populate with your keys. Never commit .env!

# Port Configuration
PORT=8000
HOST=0.0.0.0

# Database (Default: SQLite for zero-setup local execution)
DATABASE_URL=sqlite:///./mkatabawatch.db

# LLM API for AI Reconciliation Layer (Anthropic Claude or OpenAI compatible)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional fallback / alternate LLM provider
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=anthropic

# App Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
